-- Returns nil until an actual uploaded ID is supplied. Never pass a filesystem path to Image.
function Assets.resolve(key: string, publishedIds: { [string]: number }): string?
	if Assets.FILES[key] == nil then
		return nil
	end
	local id = publishedIds[key]
	if id == nil or id <= 0 or id % 1 ~= 0 then
		return nil
	end
	return "rbxassetid://" .. tostring(id)
end

